# Copie para .env (cp .env.example .env). O arquivo .env NUNCA deve ser versionado.

# Caminho do arquivo SQLite (criado automaticamente na primeira execução)
DATABASE_PATH=chat.db

# Segredo usado para assinar os tokens JWT. Troque por um valor longo e aleatório.
# Sugestão para gerar: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRE_MINUTES=120

# Modelo de linguagem: "simulado" (padrão, sem chave) ou "gemini"
LLM_PROVIDER=simulado

# Só necessário se LLM_PROVIDER=gemini (chave gratuita em https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT=20
